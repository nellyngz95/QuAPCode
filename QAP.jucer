  <EXPORTFORMATS>
    <XCODE_MAC targetFolder="Builds/MacOSX" externalLibraries="faiss&#10;onnxruntime"
               postbuildCommand="#!/bin/bash&#10;&#10;# Only run for standalone plugin builds&#10;if [[ &quot;$PRODUCT_NAME&quot; != *&quot;Standalone&quot;* ]] &amp;&amp; [[ ! -d &quot;$TARGET_BUILD_DIR/$PRODUCT_NAME.app&quot; ]]; then&#10;    echo &quot;Skipping library bundling for non-standalone target&quot;&#10;    exit 0&#10;fi&#10;&#10;APP_PATH=&quot;$TARGET_BUILD_DIR/$PRODUCT_NAME.app&quot;&#10;FRAMEWORKS_DIR=&quot;$APP_PATH/Contents/Frameworks&quot;&#10;EXECUTABLE=&quot;$APP_PATH/Contents/MacOS/$PRODUCT_NAME&quot;&#10;PROCESSED_FILE=&quot;/tmp/processed_libs_$$.txt&quot;&#10;&#10;# Exit if the executable doesn't exist yet&#10;if [ ! -f &quot;$EXECUTABLE&quot; ]; then&#10;    echo &quot;Executable not found, skipping library bundling&quot;&#10;    exit 0&#10;fi&#10;&#10;echo &quot;===== QAP Post-Build: Bundling Libraries =====&quot;&#10;mkdir -p &quot;$FRAMEWORKS_DIR&quot;&#10;&#10;# Copy libraries recursively&#10;copy_lib_and_deps() {&#10;    local lib_path=$1&#10;    local lib_name=$(basename &quot;$lib_path&quot;)&#10;    &#10;    if grep -q &quot;&#94;${lib_path}$&quot; &quot;$PROCESSED_FILE&quot; 2&gt;/dev/null; then&#10;        return&#10;    fi&#10;    echo &quot;$lib_path&quot; &gt;&gt; &quot;$PROCESSED_FILE&quot;&#10;    &#10;    # Skip system libraries&#10;    if [[ &quot;$lib_path&quot; == /usr/lib/* ]] || [[ &quot;$lib_path&quot; == /System/* ]]; then&#10;        return&#10;    fi&#10;    &#10;    # Only process homebrew OR faiss_built libraries&#10;    if [[ &quot;$lib_path&quot; != /opt/homebrew/* ]] &amp;&amp; [[ &quot;$lib_path&quot; != /Users/nellygarcia/faiss_built/* ]]; then&#10;        return&#10;    fi&#10;    &#10;    if [[ -f &quot;$lib_path&quot; ]]; then&#10;        echo &quot;  Copying $(basename $lib_path)...&quot;&#10;        cp &quot;$lib_path&quot; &quot;$FRAMEWORKS_DIR/&quot; 2&gt;/dev/null&#10;        &#10;        # Check homebrew deps&#10;        otool -L &quot;$lib_path&quot; 2&gt;/dev/null | grep &quot;/opt/homebrew&quot; | awk '{print $1}' | while read dep; do&#10;            [[ &quot;$dep&quot; != &quot;$lib_path&quot; ]] &amp;&amp; copy_lib_and_deps &quot;$dep&quot;&#10;        done&#10;        &#10;        # Check faiss_built deps&#10;        otool -L &quot;$lib_path&quot; 2&gt;/dev/null | grep &quot;/Users/nellygarcia/faiss_built&quot; | awk '{print $1}' | while read dep; do&#10;            [[ &quot;$dep&quot; != &quot;$lib_path&quot; ]] &amp;&amp; copy_lib_and_deps &quot;$dep&quot;&#10;        done&#10;    fi&#10;}&#10;&#10;# Copy all dependencies&#10;&gt; &quot;$PROCESSED_FILE&quot;&#10;&#10;# From executable - homebrew paths&#10;otool -L &quot;$EXECUTABLE&quot; | grep &quot;/opt/homebrew&quot; | awk '{print $1}' | while read lib; do&#10;    copy_lib_and_deps &quot;$lib&quot;&#10;done&#10;&#10;# From executable - faiss_built paths&#10;otool -L &quot;$EXECUTABLE&quot; | grep &quot;/Users/nellygarcia/faiss_built&quot; | awk '{print $1}' | while read lib; do&#10;    copy_lib_and_deps &quot;$lib&quot;&#10;done&#10;&#10;# Copy libgcc_s.1.1.dylib (needed by libgfortran)&#10;if [ ! -f &quot;$FRAMEWORKS_DIR/libgcc_s.1.1.dylib&quot; ]; then&#10;    GCC_LIB=$(find /opt/homebrew/Cellar/gcc -name &quot;libgcc_s.1.1.dylib&quot; 2&gt;/dev/null | head -1)&#10;    if [ -f &quot;$GCC_LIB&quot; ]; then&#10;        cp &quot;$GCC_LIB&quot; &quot;$FRAMEWORKS_DIR/&quot;&#10;        echo &quot;  &#10003; Copied libgcc_s.1.1.dylib&quot;&#10;    fi&#10;fi&#10;&#10;# Make all libraries writable&#10;chmod -R u+w &quot;$FRAMEWORKS_DIR&quot; 2&gt;/dev/null&#10;&#10;# Fix install names in executable - homebrew&#10;otool -L &quot;$EXECUTABLE&quot; | grep &quot;/opt/homebrew&quot; | awk '{print $1}' | while read lib_path; do&#10;    lib_name=$(basename &quot;$lib_path&quot;)&#10;    install_name_tool -change &quot;$lib_path&quot; &quot;@executable_path/../Frameworks/$lib_name&quot; &quot;$EXECUTABLE&quot; 2&gt;/dev/null&#10;done&#10;&#10;# Fix install names in executable - faiss_built&#10;otool -L &quot;$EXECUTABLE&quot; | grep &quot;/Users/nellygarcia/faiss_built&quot; | awk '{print $1}' | while read lib_path; do&#10;    lib_name=$(basename &quot;$lib_path&quot;)&#10;    install_name_tool -change &quot;$lib_path&quot; &quot;@executable_path/../Frameworks/$lib_name&quot; &quot;$EXECUTABLE&quot; 2&gt;/dev/null&#10;done&#10;&#10;# Fix install names in all libraries&#10;for dylib in &quot;$FRAMEWORKS_DIR&quot;/*.dylib; do&#10;    [ ! -f &quot;$dylib&quot; ] &amp;&amp; continue&#10;    lib_name=$(basename &quot;$dylib&quot;)&#10;    &#10;    # Fix the library's own ID&#10;    install_name_tool -id &quot;@executable_path/../Frameworks/$lib_name&quot; &quot;$dylib&quot; 2&gt;/dev/null&#10;    &#10;    # Fix homebrew dependencies&#10;    otool -L &quot;$dylib&quot; | grep &quot;/opt/homebrew&quot; | awk '{print $1}' | while read dep_path; do&#10;        dep_name=$(basename &quot;$dep_path&quot;)&#10;        install_name_tool -change &quot;$dep_path&quot; &quot;@executable_path/../Frameworks/$dep_name&quot; &quot;$dylib&quot; 2&gt;/dev/null&#10;    done&#10;    &#10;    # Fix faiss_built dependencies&#10;    otool -L &quot;$dylib&quot; | grep &quot;/Users/nellygarcia/faiss_built&quot; | awk '{print $1}' | while read dep_path; do&#10;        dep_name=$(basename &quot;$dep_path&quot;)&#10;        install_name_tool -change &quot;$dep_path&quot; &quot;@executable_path/../Frameworks/$dep_name&quot; &quot;$dylib&quot; 2&gt;/dev/null&#10;    done&#10;    &#10;    # Fix @rpath references (like libgcc_s)&#10;    otool -L &quot;$dylib&quot; | grep &quot;@rpath&quot; | awk '{print $1}' | while read rpath_lib; do&#10;        lib_name_only=$(basename &quot;$rpath_lib&quot;)&#10;        install_name_tool -change &quot;$rpath_lib&quot; &quot;@executable_path/../Frameworks/$lib_name_only&quot; &quot;$dylib&quot; 2&gt;/dev/null&#10;    done&#10;done&#10;&#10;rm -f &quot;$PROCESSED_FILE&quot;&#10;echo &quot;&#10003; Libraries bundled: $(ls -1 &quot;$FRAMEWORKS_DIR&quot; 2&gt;/dev/null | wc -l)&quot;&#10;&#10;# Re-sign the app&#10;echo &quot;Re-signing app bundle...&quot;&#10;for dylib in &quot;$FRAMEWORKS_DIR&quot;/*.dylib; do&#10;    [ ! -f &quot;$dylib&quot; ] &amp;&amp; continue&#10;    codesign --force --sign - &quot;$dylib&quot; 2&gt;/dev/null&#10;done&#10;codesign --force --sign - &quot;$EXECUTABLE&quot; 2&gt;/dev/null&#10;codesign --force --deep --sign - &quot;$APP_PATH&quot; 2&gt;/dev/null&#10;&#10;echo &quot;&#10003; Post-build complete!&quot;"
               xcodeValidArchs="arm64,arm64e,i386,x86_64" extraLinkerFlags="-Wl,-rpath,/Users/nellygarcia/faiss_built/lib">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug" targetName="QAP" customXcodeFlags="LD_RUNPATH_SEARCH_PATHS=&quot;@loader_path/../Frameworks @loader_path/.&quot;"
                       headerPath="/Users/nellygarcia/faiss_built/include&#10;/opt/homebrew/include/onnxruntime&#10;/opt/homebrew/include&#10;/usr/local/include"
                       libraryPath="/Users/nellygarcia/faiss_built/lib&#10;/opt/homebrew/include/onnxruntime&#10;/usr/local/lib"/>
        <CONFIGURATION isDebug="1" name="Release" targetName="QAP" headerPath="/Users/nellygarcia/faiss_built/include&#10;/opt/homebrew/include/onnxruntime&#10;/opt/homebrew/include&#10;/usr/local/include"
                       libraryPath="/Users/nellygarcia/faiss_built/lib&#10;/opt/homebrew/lib&#10;/opt/homebrew/opt/onnxruntime/lib&#10;/usr/local/lib"/>
      </CONFIGURATIONS>
